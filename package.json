{
  "name": "the-desk",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "description": "Private intelligence briefing tool for Ruben Laubscher, Head of Partnerships at InvestorKit.",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && rm -rf dist/fonts && cp -r server/og/fonts dist/fonts && node scripts/setup-reel-voice.mjs",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "probe:abs": "tsx scripts/ingest/probe-abs.ts",
    "probe:nsw-da": "tsx scripts/ingest/probe-nsw-da.ts",
    "ingest:daily": "INGEST_CLI=1 tsx scripts/ingest/dailyFeed.ts",
    "ingest:weekly": "INGEST_CLI=1 tsx scripts/ingest/weeklyEdition.ts",
    "ingest:metrics": "INGEST_CLI=1 tsx scripts/ingest/dailyMetrics.ts",
    "setup:voice": "node scripts/setup-reel-voice.mjs",
    "audit:security": "pnpm audit --audit-level=low"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@huggingface/transformers": "3.8.1",
    "@napi-rs/canvas": "0.1.100",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/react-query": "^5.101.0",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "axios": "^1.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^12.40.0",
    "jose": "6.2.3",
    "kokoro-js": "1.2.1",
    "lucide-react": "^1.21.0",
    "mysql2": "^3.23.1",
    "parse5": "8.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "read-excel-file": "9.3.10",
    "recharts": "^2.15.2",
    "rss-parser": "^3.13.0",
    "satori": "^0.26.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "superjson": "^1.13.3",
    "tailwind-merge": "^3.3.1",
    "unpdf": "1.4.0",
    "wouter": "^3.10.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/express": "^5.0.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.28.1",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "ffmpeg-static",
      "@resvg/resvg-js"
    ],
    "overrides": {
      "sharp@<0.35.0": "^0.35.3",
      "ip-address@<10.3.1": "^10.3.1",
      "body-parser@<2.3.0": "^2.3.0",
      "qs@<6.16.0": "^6.16.0",
      "fflate@<0.7.5": "^0.8.2",
      "esbuild@<0.28.1": "^0.28.1",
      "@babel/core@<7.29.1": "^7.29.1",
      "postcss@<8.5.23": "^8.5.23",
      "browserslist@<4.28.7": "^4.28.7",
      "nanoid@>=3 <3.3.18": "^3.3.18"
    }
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0"
  }
}
